+   * stake. Its own-storage reads can only be invalidated by a transaction that
+   * writes that storage, so what stake prices here is replaced by the operator
+   * vetting the code hash. Everything else about the entity's checks is unchanged.
+   */
+  private async isCanonicalRenderer(addr: string): Promise<boolean> {
+    const listed = this.networkConfig.canonicalRendererCodehashes ?? [];
+    if (listed.length === 0 || !this.getCodeHash) {
+      return false;
+    }
+    const hash = await this.getCodeHash(addr as Hex);
+    return listed.includes(hash.toLowerCase());
+  }
