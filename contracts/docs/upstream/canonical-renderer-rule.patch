+
+describe("canonical-renderer rule", () => {
+  const RENDERER = "0x4444444444444444444444444444444444444444" as const;
+  const CODEHASH = `0x${"ab".repeat(32)}` as const;
+  const OWN_SLOT = "0x05";
+
+  const config = (listed: string[]) =>
+    ({ ...fakeNetworkConfig(), canonicalRendererCodehashes: listed }) as NetworkConfig;
+
+  const onlyVerifyPay = () => ({
+    tx: baseTx([
+      { ...selfVerifyFrame(), flags: APPROVE_SCOPE.EXECUTION } as Frame,
+      payFrame(RENDERER),
+    ]),
+    trace: (accessed: any) =>
+      fakeEthrexResult([
+        ethrexFrame({ to: SENDER }),
+        ethrexFrame({ to: RENDERER, accessedSlots: { ...emptyAccessedSlots(), ...accessed } }),
+      ]),
+  });
+
+  const service = (listed: string[], hash: `0x${string}` = CODEHASH) =>
+    new FrameTxValidationService(
+      fakeStakingRegistry(), // nobody staked
+      fakeReputationService(),
+      config(listed),
+      fakeLogger(),
+      undefined,
+      async () => hash
+    );
+
+  it("admits an unstaked renderer reading its own storage when its code hash is listed", async () => {
+    const { tx, trace } = onlyVerifyPay();
+    await expect(
+      service([CODEHASH]).validate(tx, trace({ reads: { [OWN_SLOT]: ["0x0"] } }))
+    ).resolves.toMatchObject({ mempoolMembership: { [STANDARD_MEMPOOL_ID]: true } });
+  });
+
+  it("still rejects the same paymaster when its code hash is not listed", async () => {
+    const { tx, trace } = onlyVerifyPay();
+    await expect(
+      service([`0x${"cd".repeat(32)}`]).validate(tx, trace({ reads: { [OWN_SLOT]: ["0x0"] } }))
+    ).rejects.toMatchObject({ message: expect.stringContaining("unstaked payer") });
+  });
+
+  it("still rejects a listed renderer that writes its own storage", async () => {
+    const { tx, trace } = onlyVerifyPay();
+    await expect(
+      service([CODEHASH]).validate(tx, trace({ writes: { [OWN_SLOT]: 1 } }))
+    ).rejects.toMatchObject({ message: expect.stringContaining("unstaked payer") });
+  });
+});
+
+describe("canonical-renderer rule, on a real unstaked deployment", () => {
+  // A transaction to an unstaked paymaster on the public devnet, with ethrex's real trace of it. The deployed sidecar
+  // refused this very transaction ("publicSidecarRefusal" in the fixture).
+  const fx = JSON.parse(
+    readFileSync(new URL("../../../fixtures/unstaked-renderer.json", import.meta.url), "utf8")
+  );
+  const tx: FrameTransaction = {
+    chainId: BigInt(fx.tx.chainId),
+    nonceKeys: fx.tx.nonceKeys.map(BigInt),
+    nonceSeq: BigInt(fx.tx.nonceSeq),
+    sender: fx.tx.sender,
+    frames: fx.tx.frames.map((f: any) => ({
+      mode: f.mode,
+      flags: f.flags,
+      target: f.target,
+      limits: { execution: BigInt(f.limits.execution), state: BigInt(f.limits.state) },
+      value: BigInt(f.value),
+      data: f.data,
+    })),
+    signatures: fx.tx.signatures,
+    fees: {
+      maxPriorityFeePerGas: BigInt(fx.tx.fees.maxPriorityFeePerGas),
+      maxFeePerGas: BigInt(fx.tx.fees.maxFeePerGas),
+      maxFeePerBlobGas: BigInt(fx.tx.fees.maxFeePerBlobGas),
+    },
+    blobVersionedHashes: [],
+    recentRootReferences: [],
+  };
+  const service = (listed: string[]) =>
+    new FrameTxValidationService(
+      fakeStakingRegistry(),
+      fakeReputationService(),
+      { ...fakeNetworkConfig(), canonicalRendererCodehashes: listed } as NetworkConfig,
+      fakeLogger(),
+      async () => 10n ** 18n,
+      async () => fx.codehash
+    );
+
+  it("is refused without the rule, as the deployed sidecar refused it", async () => {
+    await expect(service([]).validate(tx, fx.simResult)).rejects.toMatchObject({
+      message: expect.stringContaining("unstaked payer"),
+    });
+  });
+
+  it("is admitted when the renderer's code hash is listed", async () => {
+    await expect(service([fx.codehash]).validate(tx, fx.simResult)).resolves.toMatchObject({
+      mempoolMembership: { [STANDARD_MEMPOOL_ID]: true },
+    });
+  });
+});
