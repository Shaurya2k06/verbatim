# The server reads the repository's .env in development; on a host, set these as environment variables.
# Never put any of these in client/ or in a VITE_ variable.
PORT=8787
CLIENT_ORIGIN=http://localhost:5173
SEPOLIA_RPC_URL=
SEPOLIA_LOGS_RPC_URL=
ETHERSCAN_API_KEY=
BUNDLER_URL=
BUNDLER_URL_2=
WALLET_CONNECT_PROJECT_ID=
UNISWAP_API_KEY=
# Throwaway testnet EOA for /demo's ordinary wallet. contracts/scripts/live/fund-demo-eoa.ts creates and funds it.
DEMO_EOA_KEY=
# /suites only: two owners of the Sepolia demo account, testnet only. The server signs a fixed list of operations it builds itself.
OWNER1_KEY=
OWNER2_KEY=
# Re-sign the published snapshot root when it nears expiry. Cannot attest anything new.
ATTESTOR1_KEY=
ATTESTOR2_KEY=
ATTESTOR3_KEY=
# Only when deployed away from the checkout: a directory holding sepolia.json and snapshot-sepolia.json.
DEPLOYMENTS_DIR=
